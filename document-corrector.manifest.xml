              <!--
                One control per group. Word lays a group out as one large button
                plus a column of small ones once it holds more than a couple, and
                these are all top-level actions, so they get a group each.
              -->
              <!--
                A ShowTaskpane control, unlike the ExecuteFunction ones below:
                Word itself reopens the pane, so this works even when the pane
                was closed with its own [×] and no add-in code is listening.
                It is first in the tab because it is the way back.
              -->
              <Group id="DocumentCorrector.Group.Panel">
                <Label resid="Panel.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.Panel.16" />
                  <bt:Image size="32" resid="Icon.Panel.32" />
                  <bt:Image size="80" resid="Icon.Panel.80" />
                </Icon>
                <Control xsi:type="Button" id="DocumentCorrector.Panel">
                  <Label resid="Panel.Label" />
                  <Supertip>
                    <Title resid="Panel.Label" />
                    <Description resid="Panel.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.Panel.16" />
                    <bt:Image size="32" resid="Icon.Panel.32" />
                    <bt:Image size="80" resid="Icon.Panel.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>DocumentCorrector.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
              <Group id="DocumentCorrector.Group.Review">
