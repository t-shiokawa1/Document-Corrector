                by a full-width space in the requested layout share the same group.
              -->
              <Group id="DocumentCorrector.Group.Main">
                <Label resid="Main.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.Review.16" />
                  <bt:Image size="32" resid="Icon.Review.32" />
                  <bt:Image size="80" resid="Icon.Review.80" />
                </Icon>
                <Control xsi:type="Button" id="DocumentCorrector.Review">
                  <Label resid="Review.Label" />
                  <Supertip>
                    <Title resid="Review.Label" />
                    <Description resid="Review.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.Review.16" />
                    <bt:Image size="32" resid="Icon.Review.32" />
                    <bt:Image size="80" resid="Icon.Review.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>runReview</FunctionName>
                  </Action>
                </Control>
              <!-- ShowTaskpane is deliberately after the first two actions:
                   it reopens a closed result pane without starting a new scan. -->
                <Control xsi:type="Button" id="DocumentCorrector.Panel">
                  <Label resid="Panel.Label" />
                  <Supertip>
                    <Title resid="Panel.Label" />
                    <Description resid="Panel.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.Panel.16" />
                    <bt:Image size="32" resid="Icon.Panel.32" />
                    <bt:Image size="80" resid="Icon.Panel.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>DocumentCorrector.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
              <Group id="DocumentCorrector.Group.Apply">
