  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <!--
      SharedRuntime: the ribbon buttons and the task pane run in the same
      JavaScript runtime, so a button can drive the pane's 指摘一覧 directly.
      Requires Word 2205+ on Windows / 16.61+ on Mac; on older builds Word
      ignores this whole VersionOverrides block and the pane still opens from
      [ホーム]>[アドイン].
    -->
    <Requirements>
      <bt:Sets DefaultMinVersion="1.1">
        <bt:Set Name="SharedRuntime" MinVersion="1.1" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="Document">
