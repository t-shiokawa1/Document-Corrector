       <Version> と同じ値にしておく。最初に公開したときここは 1×1 の
       透明 PNG（仮置き）で、Word はそれを憶えてしまい、あとから本物の
       絵を置いても取り直さなかった。URL が変われば取り直す。 -->
  <IconUrl DefaultValue="https://t-shiokawa1.github.io/Document-Corrector/assets/icon-32.png?v=1.16.0.24" />
  <HighResolutionIconUrl DefaultValue="https://t-shiokawa1.github.io/Document-Corrector/assets/icon-80.png?v=1.16.0.24" />
  <SupportUrl DefaultValue="https://t-shiokawa1.github.io/Document-Corrector/index.html" />

  <AppDomains>
    <AppDomain>https://t-shiokawa1.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://t-shiokawa1.github.io/Document-Corrector/taskpane.html?v=1.16.0.24" />
