  <DefaultLocale>ja-JP</DefaultLocale>
  <DisplayName DefaultValue="Document Corrector" />
  <Description DefaultValue="研究室の文章添削チェックリストのうち機械判定できる項目を点検し、指摘をマーカーで示します。" />
  <IconUrl DefaultValue="https://t-shiokawa1.github.io/Document-Corrector/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://t-shiokawa1.github.io/Document-Corrector/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://t-shiokawa1.github.io/Document-Corrector/index.html" />

  <AppDomains>
    <AppDomain>https://t-shiokawa1.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://t-shiokawa1.github.io/Document-Corrector/taskpane.html?v=1.13.0.0" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <!--
      SharedRuntime: the ribbon buttons and the task pane run in the same
      JavaScript runtime, so a button can drive the pane's 指摘一覧 directly.
      Requires Word 2205+ on Windows / 16.61+ on Mac; on older builds Word
      ignores this whole VersionOverrides block and the pane still opens from
      [挿入]>[アドイン].
    -->
    <Requirements>
      <bt:Sets DefaultMinVersion="1.1">
        <bt:Set Name="SharedRuntime" MinVersion="1.1" />
      </bt:Sets>
    </Requirements>
